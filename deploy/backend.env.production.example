# ==============================================================================
# Visa House LMS — Production Environment Configuration
# Copy this file to `/var/www/visahouse/backend/.env` on the server.
# ==============================================================================

# 1. Database Connection
# localhost is acceptable here only when MySQL runs on the same server.
DATABASE_URL=mysql+pymysql://ielts_user:REPLACE_WITH_STRONG_MYSQL_PASSWORD@localhost:3306/ielts_lms

# 2. JWT Configuration
# IMPORTANT: Generate a cryptographically secure random string (at least 64 chars)
JWT_SECRET_KEY=generate_a_secure_random_key_here
APP_ENVIRONMENT=production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. Cookie settings for JWT session persistence
REFRESH_COOKIE_NAME=ielts_lms_refresh
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# 4. Public Host URLs & CORS Configuration
# Change yourdomain.com to the real public HTTPS domain. Do not use localhost,
# 127.0.0.1, 0.0.0.0, or plain http:// values in production.
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# 5. Local file storage (resolves relative to /var/www/visahouse/backend)
# Ensure Nginx alias in /etc/nginx/sites-available/visahouse matches this path
STORAGE_DIR=../storage
# Database backups. MUST be outside STORAGE_DIR - that directory is served
# publicly as static files, so a backup inside it is an anonymous download.
BACKUP_DIR=../backups

# 6. Optional offline GeoIP database for approximate session locations
# Download GeoLite2-City.mmdb from MaxMind and place it at /var/www/visahouse/data/GeoLite2-City.mmdb.
# The app never sends session IPs to a third party for this screen; if this file
# is missing, session location displays as Unknown.
GEOIP_DB_PATH=../data/GeoLite2-City.mmdb

# 7. Settings Encryption Key
# Used for encrypting sensitive fields (like SMTP mailer password) in the database.
# Generate on your local machine using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=replace_with_new_fernet_key

# 8. Rate Limiting Protection (Anti-Abuse Settings)
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
OTP_ATTEMPT_LIMIT=5
OTP_IP_RATE_LIMIT=30
OTP_RATE_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600

# Database connection pool stability
# Keep DB_POOL_RECYCLE_SECONDS lower than MySQL wait_timeout so idle pooled
# connections are reopened before MySQL drops them. This prevents delayed login
# 500s after the app has been idle for hours.
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# 9. MySQL dump utility location
MYSQL_BIN_DIR=/usr/bin

# ==============================================================================
# Google OAuth Configuration (Set up in Google Cloud Developer Console)
# Redirect URI should be: https://yourdomain.com/api/auth/google/callback
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ==============================================================================
# First Super Admin Account Credentials
# (Run `python scripts/seed_super_admin.py` after tables are created)
# ==============================================================================
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPER_ADMIN_PASSWORD
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
