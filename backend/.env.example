# Copy to .env and fill in real values. Never commit .env.

# MySQL 8 connection (point at any reachable instance - local install, remote dev DB, etc.)
DATABASE_URL=mysql+pymysql://language_cert_user:changeme@localhost:3306/language_cert_lms

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
APP_ENVIRONMENT=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh tokens are stored only in an HttpOnly cookie.
REFRESH_COOKIE_NAME=language_cert_refresh
REFRESH_COOKIE_SAMESITE=lax
# Set only when the API and frontend share a parent domain.
REFRESH_COOKIE_DOMAIN=
# Public frontend base URL
FRONTEND_URL=http://localhost:5173

# Google OAuth login. Create an OAuth Web Client in Google Cloud and add:
# http://localhost:8000/auth/google/callback
# as an authorized redirect URI for local development.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Host header allowlist. Required when APP_ENVIRONMENT=production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Local file storage root (relative paths resolve against backend/)
STORAGE_DIR=../storage
# Database backups. MUST be outside STORAGE_DIR - that directory is served
# publicly as static files, so a backup inside it is an anonymous download.
BACKUP_DIR=../backups

# Fernet key for encrypting sensitive settings (SMTP password, FCM JSON).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Public registration abuse protection, per API process and client IP.
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600

# Credential-guessing protection, counted per client IP and per targeted email.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900

# OTP_ATTEMPT_LIMIT caps guesses against a single issued OTP challenge and is
# the control that keeps the 6-digit code from being brute forced.
OTP_ATTEMPT_LIMIT=5
OTP_IP_RATE_LIMIT=30
OTP_RATE_WINDOW_SECONDS=900

# Password reset request/confirm throttling.
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600

# Local testing only: pins the login OTP to a known value so sign-in does not
# need a working mailbox. Leave EMPTY for any deployed environment - the app
# refuses to start if this is set while APP_ENVIRONMENT=production.
DEV_STATIC_OTP_CODE=

# Directory containing mysqldump / mysql client binaries (for backups)
MYSQL_BIN_DIR=/opt/homebrew/opt/mysql/bin

# First super admin, created by scripts/seed_super_admin.py
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin
